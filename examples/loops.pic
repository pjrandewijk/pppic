.PS
# Macros, loops and conditionals. Run with:  pppic -p examples/loops.pic > loops.tex
p = atan2(0,-1)
define dial { circle rad $1 at ($2,0); arrow from ($2,0) to ($2+$1*cos($3), $1*sin($3)) }
for i = 0 to 4 do {
  dial(0.3, i*0.8, i*p/4)
  if i % 2 == 0 then { sprintf("%g", i) at (i*0.8,-0.5) } else { "odd" at (i*0.8,-0.5) }
}
.PE
