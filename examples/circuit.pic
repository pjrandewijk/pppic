.PS

# Circuit Macros diagram pre-expanded by:  pym4 -I circuit_macros examples/circuit.m4  (pym4 repository)
# Run with:  pppic -p examples/circuit.pic > circuit.tex

scale=25.4

# cct_init Version 11.1: PSTricks m4 macro settings.

  # gen_init Version 11.1: PSTricks m4 macro settings.

  define rpoint__ {
    rp_wid = last line.end.x-last line.start.x
    rp_ht = last line.end.y-last line.start.y
    rp_len = sqrt(abs((rp_wid)^2+(rp_ht)^2)); move to last line.start
    rp_ang = atan2(rp_ht,rp_wid) }

  rtod_ = 57.295779513082323;  dtor_ = 0.017453292519943295
  twopi_ = 6.2831853071795862;  pi_ = (twopi_/2)
  rp_ang = 0;  right
  define dpictools_ {0}
  define copydpictools_ {if "$1"=="" then { copy "C:/Users/prw/OneDrive/Circuit Macros/Circuit_macros11.1.3/Circuit_macros11.1.3/dpictools.pic";} \
    else { copy "$1/dpictools.pic"; } }

  linethick = 0.8
  arrowwid = 0.05*scale; arrowht = 0.1*scale
  command "\psset{linewidth=0.8pt}%";
  command "\psset{noCurrentPoint}%"

  # gen_init end

  command sprintf("\psset{arrowsize=1.1pt 4,arrowlength=1.64,arrowinset=0}%%")

# cct_init end

dx = 12.5

dy = 12.5

O: (0,0)

Vs: line invis  up dy from O
  rpoint__

  { line to Here+(((rp_len/2-(0.25*linewid))*(cos(rp_ang))),((rp_len/2-(0.25*linewid))*(sin(rp_ang))))
    move to Here+((((0.25*linewid))*(cos(rp_ang))),(((0.25*linewid))*(sin(rp_ang))))
  { Src_C: circle rad (0.25*linewid)   at Here }
  {[ Origin: Here
     m4sd_ang = rp_ang; rp_ang = 0;  right;
 Start: Here+(-(linewid/3)/2,0)
 End:   Here+((linewid/3)/2,0)
   move to Origin+(0,((1+1)/2-1)*(linewid/3)/3)
   { S1:         [ Origin: (0,0)
    Tmin: ((-(linewid/3)/2),0) ; Tmax: (((linewid/3)/2),0)
    h = ((linewid/3)/2)-(-(linewid/3)/2)
    f = twopi_/(linewid/3)
    tm = 2*f
    w0 = tm*(-(linewid/3)/2) + 2*(pi_/2)
    h0 = -((-1+(((linewid/3)/6)/2))*(h)-(((linewid/3)/6)/2)/tm*(sin(tm*(h)+w0)-sin(w0)))/h;
    n = (int(h/(twopi_/(tm/2)))+1)*12
    for i = 0 to n do {
      t = (-(linewid/3)/2)+((h0+(((linewid/3)/6)/2))*(h*i/n)-(((linewid/3)/6)/2)/tm*(sin(tm*(h*i/n)+w0)-sin(w0)));
      M4S_[i]: (t,(((linewid/3)/6))*cos((f)*(t)+((pi_/2)))) }
    Start: M4S_[0]
    End: M4S_[n]
    if !dpictools_ then { copydpictools_() }
  dfitcurve(M4S_,n,)
    ] with .Origin at Here }

 ;  up ; rp_ang = m4sd_ang
   ]    with .Origin at Here}
  line from Here+((((0.25*linewid))*(cos(rp_ang))),(((0.25*linewid))*(sin(rp_ang)))) \
          to Here+(((rp_len/2)*(cos(rp_ang))),((rp_len/2)*(sin(rp_ang))))}
  {[box invis wid (0.25*linewid)*2 ht (0.25*linewid)*2] at Here+(((rp_len/2)*(cos(rp_ang))),((rp_len/2)*(sin(rp_ang))))}
  line to Here+(((rp_len)*(cos(rp_ang))),((rp_len)*(sin(rp_ang)))) invis ;              {"$ \mathbf{V}_s$" \
     at last [].w rjust };

L:  line invis  right 2*dx
  rpoint__

         { line to Here+((((rp_len-3*(linewid/5)/2*2)/2)*(cos(rp_ang))),(((rp_len-3*(linewid/5)/2*2)/2)*(sin(rp_ang))))
   {M4coil: [ S: Here;
                {line to Here+(((-(linethick *(scale/72)/2))*((-sin(rp_ang)))),((-(linethick *(scale/72)/2))*(cos(rp_ang))))};
      for m4i=1 to 3 do {
        arc cw from Here to Here+((((linewid/5)/2*2)*(cos(rp_ang))),(((linewid/5)/2*2)*(sin(rp_ang)))) with .c at Here+((((linewid/5)/2)*(cos(rp_ang))),(((linewid/5)/2)*(sin(rp_ang))))
        {line to Here+(((-(linethick *(scale/72)/2))*((-sin(rp_ang)))),((-(linethick *(scale/72)/2))*(cos(rp_ang))))} }  ] with .S at Here }

   line from Here+(((3*(linewid/5)/2*2)*(cos(rp_ang))),((3*(linewid/5)/2*2)*(sin(rp_ang)))) to Here+((((rp_len+3*(linewid/5)/2*2)/2)*(cos(rp_ang))),(((rp_len+3*(linewid/5)/2*2)/2)*(sin(rp_ang)))) }
   line to Here+(((rp_len)*(cos(rp_ang))),((rp_len)*(sin(rp_ang)))) invis ;   {"$ jX_s$" \
     at last [].n above };

Zl: line invis  down to (Here.x,O.y)
  rpoint__

 {        line to Here+(((max(0,rp_len/2-linewid/2/2))*(cos(rp_ang))),((max(0,rp_len/2-linewid/2/2))*(sin(rp_ang))))
        line from Here+((((linewid/2)/2*2)*(cos(rp_ang))),(((linewid/2)/2*2)*(sin(rp_ang)))) \
    to Here+(((((linewid/2)/2*2)*(cos(rp_ang)))+(((linewid/5)/2)*((-sin(rp_ang))))),((((linewid/2)/2*2)*(sin(rp_ang)))+(((linewid/5)/2)*(cos(rp_ang))))) \
    then to Here+((((linewid/5)/2)*((-sin(rp_ang)))),(((linewid/5)/2)*(cos(rp_ang)))) \
    then to Here+(((-(linewid/5)/2)*((-sin(rp_ang)))),((-(linewid/5)/2)*(cos(rp_ang)))) \
    then to Here+(((((linewid/2)/2*2)*(cos(rp_ang)))+((-(linewid/5)/2)*((-sin(rp_ang))))),((((linewid/2)/2*2)*(sin(rp_ang)))+((-(linewid/5)/2)*(cos(rp_ang))))) \
    then to Here+((((linewid/2)/2*2)*(cos(rp_ang))),(((linewid/2)/2*2)*(sin(rp_ang))))
  line to Here+(((max(0,rp_len/2-linewid/2/2))*(cos(rp_ang))),((max(0,rp_len/2-linewid/2/2))*(sin(rp_ang))))}
 {[ box invis wid linewid/5 ht linewid/2 ] at Here+(((rp_len/2)*(cos(rp_ang))),((rp_len/2)*(sin(rp_ang))))}
      line to Here+(((rp_len)*(cos(rp_ang))),((rp_len)*(sin(rp_ang)))) invis ;          {"$ \mathbf{Z}_l$" \
     at last [].e ljust };

    line to O

    [       circle rad (0.04*linewid) fill 0     ] at Here
  move to last []

    box invis ht 0 wid 0 with .c at Here
    {  m4sd_ang = rp_ang; rp_ang = ((-90)*(dtor_))  ;
  line from last box.c to Here+(((linewid/4)*(cos(rp_ang))),((linewid/4)*(sin(rp_ang))))
  {line from Here+(((linewid/6)*((-sin(rp_ang)))),((linewid/6)*(cos(rp_ang)))) \
          to Here+(((-linewid/6)*((-sin(rp_ang)))),((-linewid/6)*(cos(rp_ang))))}
   {line from Here+((((linewid/16)*(cos(rp_ang)))+((linewid/9)*((-sin(rp_ang))))),(((linewid/16)*(sin(rp_ang)))+((linewid/9)*(cos(rp_ang))))) \
          to Here+((((linewid/16)*(cos(rp_ang)))+((-linewid/9)*((-sin(rp_ang))))),(((linewid/16)*(sin(rp_ang)))+((-linewid/9)*(cos(rp_ang)))))}
   line from Here+((((2*linewid/16)*(cos(rp_ang)))+((linewid/14)*((-sin(rp_ang))))),(((2*linewid/16)*(sin(rp_ang)))+((linewid/14)*(cos(rp_ang))))) \
          to Here+((((2*linewid/16)*(cos(rp_ang)))+((-linewid/14)*((-sin(rp_ang))))),(((2*linewid/16)*(sin(rp_ang)))+((-linewid/14)*(cos(rp_ang)))))
    down ; rp_ang = m4sd_ang
  }

.PE
